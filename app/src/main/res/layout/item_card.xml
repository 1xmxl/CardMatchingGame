<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_card_height"
    android:layout_margin="@dimen/item_card_margin"
    android:background="@drawable/bg_card_back"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/text_card_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/card_back"
        android:textColor="@color/text_light"
        android:textSize="@dimen/face_text_size"
        android:textStyle="bold" />

</FrameLayout>
