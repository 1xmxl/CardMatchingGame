<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/activity_padding"
    android:background="@color/window_background">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/title_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/main_hint"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/body_text_size" />

    <Button
        android:id="@+id/button_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/start_game" />

    <TextView
        android:id="@+id/text_menu_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/menu_hint"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/hint_text_size" />

    <!-- 作者署名：首页常驻显示，明确标识本应用由谁完成 -->
    <TextView
        android:id="@+id/text_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/author_signature"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/hint_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_author_package"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/author_package"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/hint_text_size" />

</LinearLayout>
